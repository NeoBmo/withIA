{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**/.env.example)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(bun test *)",
      "Bash(bun run *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(py -m pytest *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.npmrc)",
      "Read(**/.git-credentials)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.config/opencode/service.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "mcp__plugin_playwright_playwright__browser_run_code_unsafe"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(vercel --prod *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-commit-on-main.js\"",
            "if": "Bash(*git*commit*)",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-encoding.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
